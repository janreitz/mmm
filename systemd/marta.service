[Unit]
Description=Marta Music Box
# Start as early as possible, but after essential system services
DefaultDependencies=no
# With DefaultDependencies=no there is no implicit ordering at all. Do NOT
# order after local-fs.target: it waits for the /boot/firmware mount, which is
# gated by udev's slow device processing (~25s on the Zero). Marta only needs
# the root fs writable (logs) and the DAC modules loaded (modules-load.d).
After=systemd-remount-fs.service systemd-modules-load.service
Before=network-pre.target
# Early in boot the sound/serial devices may not exist yet and marta exits
# with an error until they do. Never give up restarting because of that.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=MARTA=/home/jan/mmm
# Wait for the sound card before launching: mpg123 dies instantly without it,
# and every crash/restart cycle costs several seconds of python startup on the
# Zero. Give up after 30s and let the restart logic take over as fallback.
ExecStartPre=/bin/sh -c 'i=0; until [ -e /dev/snd/controlC0 ] || [ $i -ge 150 ]; do i=$((i+1)); sleep 0.2; done'
ExecStart=/home/jan/mmm/marta/env/bin/python /home/jan/mmm/marta/Marta.py
User=root
Restart=on-failure
RestartSec=2
# Exit code 2 is the debug exit triggered by the interrupt tag: stay down.
SuccessExitStatus=2

[Install]
WantedBy=sysinit.target
